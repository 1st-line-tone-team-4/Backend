# Example only. The application does not load this file automatically.
PROFILE=production
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST/DATABASE?charset=utf8mb4
STORAGE_ROOT=/private/backend-b
PUBLIC_BASE_URL=https://YOUR-API-HOST
SIGNING_SECRET=SUPPLY-AT-LEAST-32-RANDOM-BYTES-FROM-YOUR-SECRET-MANAGER
# Optional: only needed to clean up legacy queued jobs from the previous BYOK version.
CREDENTIAL_ENCRYPTION_KEY=
AUTH_PUBLIC_KEY=SUPPLY-RS256-PUBLIC-KEY-PEM
AUTH_ISSUER=SUPPLY-A-AUTH-ISSUER
AUTH_AUDIENCE=SUPPLY-A-AUTH-AUDIENCE
# Explicit approved provider-qualified model IDs; empty enables none.
ENABLED_MODELS=
# Service-owned provider credentials for ENABLED_MODELS (OpenAI/Anthropic). Keep these in a
# secret manager in production. GEMINI_API_KEY is optional with the AI server (it uses its own
# key) and is only needed for text teach-back replies, which the AI server does not serve yet.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional internal AI server (repo 1st-line-tone-team-4/AI). When set, PDF/PNG/JPEG
# recognition uses its Upstage-backed /internal/materials/extract; empty keeps local parsing.
AI_SERVICE_URL=
AI_SERVICE_API_KEY=SAME-VALUE-AS-AI-SERVER-AI_SERVER_API_KEY
# Optional fixed gemini:<model> IDs generated through the AI server. Leave empty to use the AI
# server's own model list (GET /internal/models). Requires AI_SERVICE_URL; must not overlap
# ENABLED_MODELS.
AI_SERVICE_MODELS=
# Optional direct model for text teach-back replies (the AI server has no endpoint for them),
# e.g. openai:<model>. Uses the matching OPENAI_API_KEY/ANTHROPIC_API_KEY; empty keeps Gemini.
TEACHBACK_TEXT_MODEL=
# Optional exact frontend origins for cross-origin browser access (comma-separated).
# Leave empty when the frontend reaches /v1 through a same-origin proxy.
CORS_ALLOWED_ORIGINS=
